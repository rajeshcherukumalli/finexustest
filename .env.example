# =============================================================================
# Scraper login — copy to .env and fill for the app you are scraping.
# Never commit .env. Secret values are never sent to the LLM (only key names).
# =============================================================================
#
# REQUIRED for any authenticated scrape:
QA_LOGIN_URL=https://yourapp.com/login
#
# Pick ONE login style below. Do not mix password and OTP vars in the same .env
# until QA_AUTH_MODE is implemented (see GUIDE.md).
#
# --- Style 1: Username + password ---
# QA_USERNAME=your_username
# QA_PASSWORD=your_password
#
# --- Style 2: Email + password (use QA_USERNAME for the email address) ---
# QA_USERNAME=admin@yourapp.com
# QA_PASSWORD=your_password
#
# --- Style 3: Mobile + OTP ---
# QA_TEST_MOBILE=9876543210
# QA_TEST_OTP=123456
#
# Example placeholders (remove or replace):
QA_USERNAME=admin@yourapp.com
QA_PASSWORD=yourpassword
QA_TEST_MOBILE=
QA_TEST_OTP=

# Optional — slow SPAs / QA environments (default 60000)
# QA_NAVIGATION_TIMEOUT_MS=90000

# Optional — max no-href button clicks per page during scrape (default 30, 0 disables)
# QA_BUTTON_PROBE_LIMIT=30

# Planned — explicit auth mode (not wired in code yet): password | email_password | mobile_otp | auto
# QA_AUTH_MODE=mobile_otp

# Optional — legacy Docker web UI only (claude CLI in container has no interactive login)
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# Backend (set automatically in Docker)
# QA_DATA_ROOT=/data
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173
